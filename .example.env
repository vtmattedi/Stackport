# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_long_random_string
JWT_EXPIRY=7d

# bcrypt hash of the admin password — never store plaintext
# Generate with: node -e "require('bcrypt').hash('yourpassword',12).then(console.log)"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=CHANGE_ME_bcrypt_hash

# ─── Webhooks ─────────────────────────────────────────────────────────────────
# Shared HMAC secret for validating incoming webhook payloads
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_ME_long_random_string

# Absolute path on the VPS where allowed scripts live
SCRIPTS_DIR=/opt/mwdevops/scripts

# ─── Security ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
SQLITE_PATH=./data/mwdevops.sqlite

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
