# Development reference. VPS installs generate /etc/stackport configuration.
PORT=3000
NODE_ENV=development
# Generate each secret with openssl rand -hex 32. Never commit real values.
JWT_SECRET=CHANGE_ME_random_secret
JWT_EXPIRY=7d
WEBHOOK_SECRET=CHANGE_ME_random_secret
# Admin identity is created through browser bootstrap, not this file.
STACKPORT_DOMAIN=
CERTBOT_EMAIL=
ALLOWED_ORIGINS=http://localhost:3000
SQLITE_PATH=./data/stackport.sqlite
DEPLOY_ROOT=./data/repos
SCRIPTS_DIR=./data/scripts
LOG_LEVEL=info
LOG_DIR=./logs
# App and nginx mount the same configuration at this path.
NGINX_PATH=/etc/nginx
APP_SERVICE_NAME=stackport
HOST_PROJECT_ROOT=/var/lib/stackport/app
