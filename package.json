{
  "name": "stackport-mw-vps-manager",
  "version": "1.0.27",
  "description": "Small VPS manager for running multiple projects on one server",
  "main": "dist/index.js",
  "scripts": {
    "dev:api": "nodemon --watch src --ext ts,json --exec tsx src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "dev:mcp": "tsx src/mcp/server.ts",
    "dev": "concurrently -n api,client -c blue,green \"npm run dev:api\" \"npm run dev:client\"",
    "version:bump": "node scripts/bump-version.cjs .",
    "build:api:compile": "tsc",
    "build:api": "npm run version:bump && npm run build:api:compile",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:api && npm run build:client",
    "build:dry:api": "npm run build:api:compile",
    "build:dry:client": "npm --prefix client run build:dry",
    "build:dry": "npm run build:dry:api && npm run build:dry:client",
    "mcp": "node dist/mcp/server.js",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "eslint-plugin-security": "^4.0.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.3",
    "shadcn": "^4.11.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "socket.io": "^4.8.3",
    "typeorm": "^1.0.0",
    "zod": "^3.25.76"
  }
}
